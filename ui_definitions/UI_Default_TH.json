                            "focus": { "background": "$colours.paper.muted" },
                            "pressed": { "background": "$colours.paper.soft" },
                            "disabled": { "background": "$colours.paper.muted", "colour": "$colours.ink.mute", "marker": "$colours.ink.mute" } },
      "button.icon":      { "extends": "button.secondary", "padding": [6, 8], "min.height": 0, "icon.size": "$sizes.icon.key" },

      "toggle":           { "background": "$colours.accent", "track": "$colours.ink.mute", "colour": "$colours.paper.cream", "radius": "$radii.switch", "width": 44, "height": 22, "knob": 16,
                            "disabled": { "track": "$colours.paper.muted", "background": "$colours.paper.muted" } },
      "slider":           { "colour": "$colours.accent", "track": "$colours.paper.muted", "thickness": 4, "knob": 14, "value.gap": 8, "value.width": 36,
                            "disabled": { "colour": "$colours.ink.mute" } },
      "slider.dark":      { "extends": "slider", "colour": "$colours.accent.warm", "track": "$colours.ink.soft" },
      "bar":              { "colour": "$colours.accent", "track": "$colours.paper.muted", "thickness": 18, "stripe": "$spacing.stripe.period", "stripe.darken": 0.82, "border": { "colour": "$colours.ink.night", "width": "$spacing.inset.border" } },
      "bar.yellow":       { "extends": "bar", "colour": "$colours.accent.warm" },
      "bar.ink":          { "extends": "bar", "colour": "$colours.ink.night" },
      "bar.hud":          { "colour": "$colours.accent", "track": "$colours.bg.overlay", "thickness": 8, "border": { "colour": "$colours.ink.night", "width": 1 } },
      "bar.health":       { "extends": "bar.hud" },
      "bar.stamina":      { "extends": "bar.hud", "colour": "$colours.accent.warm" },
      "bar.durability":   { "colour": "$colours.accent.warm", "track": "$colours.bg.overlay", "thickness": 3 },
      "bar.loading":      { "extends": "bar", "thickness": 14 },
      "dropdown":         { "font": "$fonts.display", "size": "$sizes.dropdown", "tracking": 0.08, "case": "upper", "colour": "$colours.ink.night", "background": "$colours.paper.bright", "padding": [4, 10], "border": { "colour": "$colours.ink.night", "width": "$spacing.inset.border" }, "item.style": "dropdown.item",
                            "hover": { "background": "$colours.paper.muted" },
                            "focus": { "background": "$colours.paper.muted" },
                            "pressed": { "background": "$colours.accent", "colour": "$colours.text" },
                            "disabled": { "background": "$colours.paper.muted", "colour": "$colours.ink.mute" } },
      "dropdown.item":    { "extends": "dropdown", "padding": [6, 10], "hover": { "background": "$colours.paper.muted" } },
      "input":            { "font": "$fonts.terminal", "size": "$sizes.input", "tracking": 0.04, "colour": "$colours.ink.night", "background": "$colours.paper.bright", "padding": [6, 10], "border": { "colour": "$colours.ink.night", "width": "$spacing.inset.border" }, "placeholder": "$colours.ink.mute",
                            "focus": { "border": { "colour": "$colours.accent", "width": "$spacing.inset.border" } },
                            "disabled": { "background": "$colours.paper.muted", "colour": "$colours.ink.mute" } },
      "list":             { },
      "list.pane":        { "extends": "panel.pane" },
      "list.row":         { "font": "$fonts.display", "size": "$sizes.list.row", "tracking": 0.04, "case": "upper", "colour": "$colours.ink.night", "padding": ["$spacing.list.row.pad.v", "$spacing.list.row.pad.h"], "marker": "$colours.accent", "separator": "$colours.rule.dashed", "separator.width": "$spacing.list.separator", "icon.size": "$sizes.icon.list", "right.style": "text.meta", "empty.style": "text.empty",
                            "hover": { "background": "$colours.paper.muted" },
                            "focus": { "background": "$colours.paper.muted" },
                            "pressed": { "background": "$colours.accent", "colour": "$colours.text" },
                            "disabled": { "colour": "$colours.ink.mute" } },
      "list.roster":      { "extends": "list" },
      "list.hotbar":      { },
      "tabbar":           { "font": "$fonts.display", "size": "$sizes.tab", "tracking": 0.08, "case": "upper", "colour": "$colours.ink.soft", "padding": [8, 16], "border": { "colour": "$colours.ink.night", "width": "$spacing.tab.underline" },
                            "hover": { "colour": "$colours.ink.night" },
                            "focus": { "colour": "$colours.ink.night" },
                            "pressed": { "background": "$colours.accent", "colour": "$colours.text" } },
      "ring":             { "colour": "$colours.accent", "thickness": 4, "track": "$colours.ring.track", "label.style": "text.meta" },
      "ring.hold":        { "extends": "ring" },
      "ring.cook":        { "extends": "ring", "colour": "$colours.success.basket", "thickness": 6 },
      "ring.key":         { "extends": "ring", "thickness": 3 },
      "actionbar":        { "font": "$fonts.body", "size": "$sizes.actionbar", "colour": "$colours.text", "gap": "$spacing.sm", "sub.style": "text.hud.dim" },
      "actionbar.menu":   { "extends": "actionbar", "colour": "$colours.ink.night", "sub.style": "text.caption" },
      "toast":            { "font": "$fonts.display", "size": "$sizes.toast", "tracking": 0.06, "case": "upper", "colour": "$colours.paper.bright", "background": "$colours.ink.night", "padding": [8, 12], "border": { "colour": "$colours.ink.night", "width": 2 }, "stripe": "$colours.accent", "stripe.width": 4, "body.style": "text.hud", "in": "$durations.toast.in", "out": "$durations.toast.out", "life": "$durations.toast.life", "gap": "$spacing.toast.gap" },
      "toast.error":      { "extends": "toast", "stripe": "$colours.notification.error", "colour": "$colours.danger.type" },
      "toast.success":    { "extends": "toast", "stripe": "$colours.success.basket" },
      "toast.warning":    { "extends": "toast", "stripe": "$colours.notification.warning" },
      "toast.info":       { "extends": "toast", "stripe": "$colours.notification.tip" },
      "toast.tip":        { "extends": "toast", "stripe": "$colours.notification.tip", "in": "$durations.notification.in", "out": "$durations.notification.out", "life": "$durations.notification.life" },
      "toast.inventory":  { "extends": "toast.tip", "stripe": "$colours.notification.inventory" },
      "toast.event":      { "extends": "toast.tip", "stripe": "$colours.notification.event" },
      "toast.alarm":      { "extends": "toast.tip", "stripe": "$colours.notification.alarm" },
      "toast.playerjoined": { "extends": "toast.tip", "stripe": "$colours.notification.playerjoined" },
      "toast.playerdied": { "extends": "toast.tip", "stripe": "$colours.notification.playerdied" },
      "toast.progression": { "extends": "toast.tip", "stripe": "$colours.notification.progression" },
      "fade":             { "background": "$colours.ink.night", "duration": "$durations.fade" },
      "fade.screen":      { "extends": "fade" },
      "fade.hit":         { "background": "$colours.accent.dim", "duration": "$durations.hitsplat.life.min", "band": 0.35 },
      "fade.flash":       { "background": "$colours.text", "duration": "$durations.fade.in" },
      "image":            { },
      "image.icon":       { "colour": "$colours.ink.night" },
      "marker":           { },
      "slot":             { "background": "$colours.paper.bright", "border": { "colour": "$colours.ink.night", "width": "$spacing.inset.border" }, "padding": 3,
                            "hover": { "shadow": { "offset": [3, 3], "colour": "$colours.ink.night" } },
                            "pressed": { "background": "$colours.accent", "shadow": { "offset": [3, 3], "colour": "$colours.ink.night" } } },
      "slot.selected":    { "extends": "slot", "background": "$colours.accent", "shadow": { "offset": [3, 3], "colour": "$colours.ink.night" } },
      "slot.hotbar":      { "background": "$colours.bg.overlay", "radius": "$radii.hotbar.slot", "border": { "colour": "$colours.ink.night", "width": 2 } },
      "slot.hotbar.selected": { "extends": "slot.hotbar", "border": { "colour": "$colours.accent.warm", "width": 2 } },
      "slot.stomach":     { "extends": "slot.hotbar", "radius": "$radii.stomach.slot" },
      "rule.panel":       { "border": { "colour": "$colours.ink.night", "width": "$spacing.panel.border" } },
      "rule.dashed":      { "border": { "colour": "$colours.ink.mute", "width": 2 } }
    }
  }
}
