                                "Yaw": "{#et-cam-yaw.value}",
                                "Pitch": "{#et-cam-pitch.value}",
                                "Distance": "{#et-cam-distance.value}",
                                "Height": "{#et-cam-height.value}"
                              }
                            }
                          }
                        }
                      ]
                    },
                    {
                      "widget": "panel",
                      "layout": "horizontal",
                      "gap": 6,
                      "children": [
                        {
                          "widget": "text",
                          "text": "Pitch",
                          "style": "dev.label",
                          "slot": {
                            "width": 84,
                            "valign": "center"
                          }
                        },
                        {
                          "widget": "slider",
                          "id": "et-cam-pitch",
                          "min": -80,
                          "max": 80,
                          "step": 1,
                          "track_width": 180,
                          "show_value": true,
                          "value_format": "{0}",
                          "style": "dev.slider.blue",
                          "slot": {
                            "fill": true,
                            "valign": "center"
                          },
                          "bind": {
                            "value": "UI.EquipTuner.State.CamPitch"
                          },
                          "on": {
                            "commit": {
                              "cmd": "UI.Cmd.EquipTuner.SetCamera",
                              "args": {
                                "Yaw": "{#et-cam-yaw.value}",
                                "Pitch": "{#et-cam-pitch.value}",
                                "Distance": "{#et-cam-distance.value}",
                                "Height": "{#et-cam-height.value}"
                              }
                            }
                          }
                        }
                      ]
                    },
                    {
                      "widget": "panel",
                      "layout": "horizontal",
                      "gap": 6,
                      "children": [
                        {
                          "widget": "text",
                          "text": "Distance",
                          "style": "dev.label",
                          "slot": {
                            "width": 84,
                            "valign": "center"
                          }
                        },
                        {
                          "widget": "slider",
                          "id": "et-cam-distance",
                          "min": 30,
                          "max": 800,
                          "step": 5,
                          "track_width": 180,
                          "show_value": true,
                          "value_format": "{0}",
                          "style": "dev.slider.blue",
                          "slot": {
                            "fill": true,
                            "valign": "center"
                          },
                          "bind": {
                            "value": "UI.EquipTuner.State.CamDistance"
                          },
                          "on": {
                            "commit": {
                              "cmd": "UI.Cmd.EquipTuner.SetCamera",
                              "args": {
                                "Yaw": "{#et-cam-yaw.value}",
                                "Pitch": "{#et-cam-pitch.value}",
                                "Distance": "{#et-cam-distance.value}",
                                "Height": "{#et-cam-height.value}"
                              }
                            }
                          }
                        }
                      ]
                    },
                    {
                      "widget": "panel",
                      "layout": "horizontal",
                      "gap": 6,
                      "children": [
                        {
                          "widget": "text",
                          "text": "Height",
                          "style": "dev.label",
                          "slot": {
                            "width": 84,
                            "valign": "center"
                          }
                        },
                        {
                          "widget": "slider",
                          "id": "et-cam-height",
                          "min": -20,
                          "max": 220,
                          "step": 1,
                          "track_width": 180,
                          "show_value": true,
                          "value_format": "{0}",
                          "style": "dev.slider.blue",
                          "slot": {
                            "fill": true,
                            "valign": "center"
                          },
                          "bind": {
                            "value": "UI.EquipTuner.State.CamHeight"
                          },
                          "on": {
                            "commit": {
                              "cmd": "UI.Cmd.EquipTuner.SetCamera",
                              "args": {
                                "Yaw": "{#et-cam-yaw.value}",
                                "Pitch": "{#et-cam-pitch.value}",
                                "Distance": "{#et-cam-distance.value}",
                                "Height": "{#et-cam-height.value}"
                              }
                            }
                          }
                        }
                      ]
                    }
                  ]
                },
                {
                  "widget": "panel",
                  "layout": "horizontal",
                  "id": "et-buttons",
                  "focus": "group",
                  "gap": 6,
                  "children": [
                    {
                      "widget": "button",
                      "label": "Reset piece",
                      "style": "dev.button",
                      "on": {
                        "click": {
                          "cmd": "UI.Cmd.EquipTuner.ResetRow"
                        }
                      }
                    },
                    {
                      "widget": "button",
                      "label": "Copy to L/R partner",
                      "style": "dev.button",
                      "on": {
                        "click": {
                          "cmd": "UI.Cmd.EquipTuner.CopyToPair"
                        }
                      }
                    },
                    {
                      "widget": "button",
                      "label": "Revert item",
                      "style": "dev.button",
                      "on": {
                        "click": {
                          "cmd": "UI.Cmd.EquipTuner.Revert"
                        }
                      }
                    }
                  ]
                },
                {
                  "widget": "panel",
                  "layout": "horizontal",
                  "id": "et-buttons-2",
                  "focus": "group",
                  "gap": 6,
                  "children": [
                    {
                      "widget": "button",
                      "label": "Save to JSON",
                      "style": "dev.button.save",
                      "on": {
                        "click": {
                          "cmd": "UI.Cmd.EquipTuner.Save"
                        }
                      }
                    },
                    {
                      "widget": "button",
                      "label": "Close",
                      "style": "dev.button",
                      "on": {
                        "click": {
                          "cmd": "UI.Cmd.EquipTuner.Toggle"
                        }
                      }
                    }
                  ]
                },
                {
                  "widget": "text",
                  "style": "dev.text.dirty",
                  "bind": {
                    "text": "UI.EquipTuner.State.bDirty ? 'Unsaved edits on this item.' : ''"
                  }
                },
                {
                  "widget": "text",
                  "style": "dev.text.json",
                  "wrap": true,
                  "bind": {
                    "text": "UI.EquipTuner.State.JsonPath != '' ? \"Saves to {UI.EquipTuner.State.JsonPath}\" : ''"
                  }
                }
              ]
            }
          ]
        }
      ]
    }
  }
}
