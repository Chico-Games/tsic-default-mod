{
  "id": "UI_EquipTuner_SC",
  "class": "ScpUiScreenDefinition",
  "properties": {
    "screen": "EquipTuner",
    "layer": "menu",
    "input_mode": "InputMode.Menu.Generic",
    "cancel": "UI.Cmd.EquipTuner.Toggle",
    "actions": [
      {
        "action": "accept",
        "label": "Select"
      },
      {
        "action": "back",
        "label": "Close"
      }
    ],
    "uses": [
      "UI.EquipTuner.State"
    ],
    "tree": {
      "widget": "panel",
      "layout": "overlay",
      "id": "et-root",
      "style": "screen.clear",
      "on": {
        "show": {
          "cmd": "UI.Cmd.EquipTuner.RequestState"
        }
      },
      "children": [
        {
          "widget": "panel",
          "layout": "scroll",
          "id": "et-panel",
          "style": "dev.panel.dock",
          "slot": {
            "align": "right",
            "valign": "fill",
            "width": 440
          },
          "children": [
            {
              "widget": "panel",
              "layout": "vertical",
              "gap": 8,
              "slot": {
                "padding": [
                  14,
                  12,
                  14,
                  16
                ]
              },
              "children": [
                {
                  "widget": "text",
                  "text": "Equipment pose tuner",
                  "style": "dev.title.tuner.bench"
                },
                {
                  "widget": "text",
                  "bind": {
                    "text": "!has:UI.EquipTuner.State ? '' : UI.EquipTuner.State.Message != '' ? UI.EquipTuner.State.Message : UI.EquipTuner.State.bEquipped ? '' : 'Item is not on the player.'",
                    "style": "has:UI.EquipTuner.State ? (!UI.EquipTuner.State.bHasTuner ? 'dev.status.bad' : 'dev.status') : 'dev.status'"
                  }
                },
                {
                  "widget": "panel",
                  "layout": "horizontal",
                  "gap": 8,
                  "children": [
                    {
                      "widget": "button",
                      "label": "<",
                      "style": "dev.button",
                      "id": "et-prev",
                      "focus": "initial",
                      "slot": {
                        "valign": "center"
                      },
                      "on": {
                        "click": {
                          "cmd": "UI.Cmd.EquipTuner.Nav",
                          "args": {
                            "Delta": -1
                          }
                        }
                      }
                    },
                    {
                      "widget": "panel",
                      "layout": "vertical",
                      "slot": {
                        "fill": true,
                        "valign": "center"
                      },
                      "children": [
                        {
                          "widget": "text",
                          "style": "dev.label.strong",
                          "justify": "Center",
                          "bind": {
                            "text": "UI.EquipTuner.State.Items.Num > 0 ? \"{UI.EquipTuner.State.ItemIndex + 1} / {UI.EquipTuner.State.Items.Num}  -  {UI.EquipTuner.State.ItemName}\" : '-'"
                          }
                        },
                        {
                          "widget": "text",
                          "style": "dev.meta",
                          "justify": "Center",
                          "wrap": true,
                          "bind": {
                            "text": "UI.EquipTuner.State.ItemId != '' ? \"{UI.EquipTuner.State.ItemId}  ·  {UI.EquipTuner.State.Slot}  ·  {UI.EquipTuner.State.LayerClass}\" : ''"
                          }
                        }
                      ]
                    },
                    {
                      "widget": "button",
                      "label": ">",
                      "style": "dev.button",
                      "id": "et-next",
                      "slot": {
                        "valign": "center"
                      },
                      "on": {
                        "click": {
                          "cmd": "UI.Cmd.EquipTuner.Nav",
                          "args": {
                            "Delta": 1
                          }
                        }
                      }
                    }
                  ]
                },
                {
                  "widget": "dropdown",
                  "id": "et-items",
                  "min_width": 380,
                  "slot": {
                    "align": "fill"
                  },
                  "bind": {
                    "values": "UI.EquipTuner.State.Items.Id",
                    "options": "UI.EquipTuner.State.Items.Name",
                    "value": "UI.EquipTuner.State.ItemId"
                  },
                  "on": {
                    "change": {
                      "cmd": "UI.Cmd.EquipTuner.SelectItem",
                      "args": {
                        "ItemId": "{self.value}"
                      }
                    }
                  }
                },
                {
                  "widget": "panel",
                  "layout": "vertical",
                  "id": "et-piece",
                  "style": "dev.section",
                  "gap": 5,
                  "focus": "group",
                  "children": [
                    {
                      "widget": "text",
                      "text": "Piece",
                      "style": "dev.section.head"
                    },
                    {
                      "widget": "list",
                      "id": "et-rows",
                      "horizontal": true,
                      "selectable": true,
                      "empty_text": "No pieces.",
                      "style": "dev.list.chips",
                      "bind": {
                        "items": "UI.EquipTuner.State.Rows",
                        "selected": "UI.EquipTuner.State.RowIndex"
                      },
                      "on": {
                        "activate": {
                          "cmd": "UI.Cmd.EquipTuner.SelectRow",
                          "args": {
                            "Index": "{self.value}"
                          }
                        }
                      },
                      "template": {
                        "widget": "button",
                        "label": "",
                        "style": "dev.button",
                        "bind": {
                          "label": "item.Socket",
                          "style": "item.bFocused ? 'dev.button.on.blue' : item.bSocketExists ? 'dev.button' : 'dev.button.bad'"
                        }
                      }
                    },
                    {
                      "widget": "panel",
                      "layout": "horizontal",
                      "gap": 6,
                      "children": [
                        {
                          "widget": "text",
                          "text": "Socket",
                          "style": "dev.label",
                          "slot": {
                            "width": 84,
                            "valign": "center"
                          }
                        },
                        {
                          "widget": "dropdown",
                          "id": "et-socket",
                          "min_width": 200,
                          "slot": {
                            "fill": true,
                            "valign": "center"
                          },
                          "bind": {
                            "values": "UI.EquipTuner.State.Sockets",
                            "value": "UI.EquipTuner.State.Row.Socket"
                          },
                          "on": {
                            "change": {
                              "cmd": "UI.Cmd.EquipTuner.SetSocket",
                              "args": {
                                "Socket": "{self.value}"
                              }
                            }
                          }
                        }
                      ]
                    },
                    {
                      "widget": "text",
                      "style": "dev.text.warn",
                      "wrap": true,
                      "bind": {
                        "visible": "UI.EquipTuner.State.Rows.Num > 0 ? !UI.EquipTuner.State.Row.bSocketExists : false",
                        "text": "\"{UI.EquipTuner.State.Row.Socket} does not exist on {UI.EquipTuner.State.BodyMesh}: the piece is sitting at the mesh origin.\""
                      }
                    }
                  ]
                },
                {
                  "widget": "panel",
                  "layout": "vertical",
                  "id": "et-location",
                  "style": "dev.section",
                  "gap": 5,
                  "focus": "group",
                  "children": [
                    {
                      "widget": "text",
                      "text": "Location (cm)",
                      "style": "dev.section.head"
                    },
                    {
                      "widget": "panel",
                      "layout": "horizontal",
                      "gap": 6,
                      "children": [
                        {
                          "widget": "text",
                          "text": "X (forward)",
                          "style": "dev.label",
                          "slot": {
                            "width": 84,
                            "valign": "center"
                          }
                        },
                        {
                          "widget": "slider",
                          "id": "et-LocX",
                          "min": -60,
                          "max": 60,
                          "step": 0.1,
                          "track_width": 180,
                          "show_value": true,
                          "value_format": "{0}",
                          "style": "dev.slider.blue",
                          "slot": {
                            "fill": true,
                            "valign": "center"
                          },
                          "bind": {
                            "value": "UI.EquipTuner.State.Row.LocX"
                          },
                          "on": {
                            "commit": {
                              "cmd": "UI.Cmd.EquipTuner.SetValue",
                              "args": {
                                "Field": "LocX",
                                "Value": "{self.value}"
                              }
                            }
                          }
