{
  "id": "UI_HudConditions_HD",
  "class": "ScpUiScreenDefinition",
  "properties": {
    "layer": "hud",
    "uses": [ "UI.Hud.Visibility", "UI.Conditions.State" ],
    "tree": {
      "id": "conditions-root", "widget": "panel", "layout": "overlay", "style": "panel.flat",
      "bind": { "visible": "UI.Hud.Visibility[conditions].bHidden ? false : !UI.Hud.Visibility[all].bHidden" },
      "children": [
        { "id": "conditions-column", "widget": "list", "style": "list", "selectable": false, "reverse_order": true,
          "slot": { "anchor": "bottom-left", "offset": [280, -30] },
          "bind": { "items": "UI.Conditions.State.Conditions" },
          "template": { "id": "condition-chip", "widget": "panel", "layout": "horizontal", "gap": 6, "slot": { "padding": [0, 2, 0, 2], "align": "left" },
            "bind": { "style": "item.Severity == 'Starvation' ? 'hud.chip.starvation' : (item.Id == 'Hunger' ? 'hud.chip.harm' : (item.Id == 'ReducedRegen' ? 'hud.chip.harm' : (item.Id == 'CapStamina' ? 'hud.chip.harm' : (item.bFromSelected ? 'hud.chip.selected' : (item.Kind == 'Debuff' ? 'hud.chip.debuff' : 'hud.chip.buff')))))" },
            "children": [
              { "widget": "image", "plate_when_missing": false, "slot": { "valign": "center" },
                "bind": { "source": "\"icon:{item.Icon}\"", "size": "'14,14'" } },
              { "id": "condition-name", "widget": "text", "slot": { "valign": "center" },
                "bind": {
                  "text": "item.Name == '' ? item.Id : item.Name",
                  "style": "item.Severity == 'Starvation' ? 'hud.chip.starvation' : (item.Id == 'Hunger' ? 'hud.chip.harm' : (item.Id == 'ReducedRegen' ? 'hud.chip.harm' : (item.Id == 'CapStamina' ? 'hud.chip.harm' : (item.Kind == 'Debuff' ? 'hud.chip.debuff' : 'hud.chip.buff'))))"
                } },
              { "widget": "text", "style": "hud.chip.buff", "text": "+", "case": "None", "slot": { "valign": "center" },
                "bind": { "visible": "item.RefreshCount > 0" } }
            ] } }
      ]
    }
  }
}
