{
  "id": "UI_HudStomach_HD",
  "class": "ScpUiScreenDefinition",
  "properties": {
    "layer": "hud",
    "uses": [ "UI.Hud.Visibility", "UI.Stomach.State" ],
    "tree": {
      "id": "stomach-root", "widget": "panel", "layout": "overlay", "style": "panel.flat",
      "bind": { "visible": "UI.Hud.Visibility[stomach].bHidden ? false : !UI.Hud.Visibility[all].bHidden" },
      "children": [
        { "id": "stomach-column", "widget": "list", "style": "list", "selectable": false, "reverse_order": true,
          "slot": { "anchor": "bottom-left", "offset": [230, -30] },
          "bind": { "items": "UI.Stomach.State.Slots" },
          "template": { "id": "stomach-slot", "widget": "panel", "layout": "overlay", "width": 42, "height": 42, "slot": { "padding": [0, 3, 0, 3] },
            "bind": { "style": "item.ItemId == '' ? 'hud.slot.stomach.empty' : (item.bSelected ? 'hud.slot.stomach.selected' : 'hud.slot.stomach')" },
            "children": [
              { "widget": "panel", "style": "hud.slot.mark", "width": 10, "height": 10, "slot": { "anchor": "center" },
                "bind": { "visible": "item.ItemId == ''" } },
              { "widget": "image", "slot": { "anchor": "center" },
                "bind": { "source": "\"item:{item.ItemId}\"", "size": "'30,30'", "visible": "item.ItemId != ''" } },
              { "widget": "progressbar", "style": "hud.digest", "slot": { "anchor": "bottom-center", "padding": [4, 0, 4, 3] },
                "bind": { "progress": "item.Duration > 0 ? item.RemainingTime / item.Duration : 0", "visible": "item.ItemId != '' ? item.Duration > 0 : false" } }
            ] } }
      ]
    }
  }
}
