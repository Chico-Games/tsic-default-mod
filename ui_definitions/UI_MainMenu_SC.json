{
  "id": "UI_MainMenu_SC",
  "class": "ScpUiScreenDefinition",
  "properties": {
    "screen": "MainMenu",
    "layer": "menu",
    "input_mode": "InputMode.Menu.MainMenu",
    "cancel": "",
    "actions": [ { "action": "accept", "label": "Select" } ],
    "uses": [ "UI.Settings.Value", "UI.Boot.ShaderGate" ],
    "tree": {
      "id": "stage", "widget": "panel", "layout": "overlay", "style": "panel.stage.title", "backdrop": "Maze",
      "children": [
        { "id": "cover", "widget": "panel", "layout": "vertical", "style": "panel.cover", "slot": { "align": "center", "valign": "center", "width": 520 },
          "children": [
            { "id": "masthead", "widget": "panel", "layout": "vertical", "slot": { "padding": [18, 22, 10, 22] },
              "children": [
                { "widget": "text", "style": "text.kicker", "text": "The Store is" },
                { "widget": "panel", "layout": "horizontal",
                  "children": [
                    { "widget": "text", "style": "text.masthead", "text": "Closed", "line_height": 0.9 },
                    { "widget": "text", "style": "text.masthead", "text": ".", "line_height": 0.9, "bind": { "colour": "'#E60000'" } }
                  ] },
                { "widget": "panel", "layout": "horizontal", "slot": { "padding": [6, 0, 0, 0] },
                  "children": [
                    { "widget": "text", "style": "text.eyebrow", "text": "Vol.1 — The Store Opens", "slot": { "fill": true, "valign": "center" } },
                    { "id": "kicker", "widget": "text", "style": "text.date", "text": "RESTOCK PENDING · DEC 1983", "slot": { "align": "right", "valign": "center" },
                      "cycle_seconds": 45,
                      "cycle": [
                        "PREVIEW ISSUE · DEC 1983",
                        "OPENING DAY · DEC 1983",
                        "GRAND OPENING · DEC 1983",
                        "DEBUT EDITION · DEC 1983",
                        "INAUGURAL ISSUE · DEC 1983",
                        "CHARTER ISSUE · DEC 1983",
                        "FIRST PRESSING · DEC 1983",
                        "FRESH OFF THE PRESS · DEC 1983",
                        "RIBBON CUTTING · DEC 1983",
                        "SOFT OPENING · DEC 1983",
                        "NOW HIRING · DEC 1983",
                        "ALL DEPARTMENTS OPEN · DEC 1983",
                        "FREE WITH PURCHASE · DEC 1983",
                        "WHILE SUPPLIES LAST · DEC 1983",
                        "AS SEEN ON TV · DEC 1983",
                        "COLLECTOR'S EDITION · DEC 1983",
                        "DOORS OPEN SOON · DEC 1983",
                        "STOCK ARRIVING · DEC 1983",
                        "MIND THE FLOORS · DEC 1983",
                        "WATCH YOUR STEP · DEC 1983",
                        "FOR DISPLAY ONLY · DEC 1983",
                        "RESTOCK PENDING · DEC 1983",
                        "AFTER HOURS · DEC 1983",
                        "NO REFUNDS · DEC 1983",
                        "FINAL SALE · DEC 1983",
                        "CHECK BEHIND YOU · DEC 1983",
                        "AISLE 13 SEALED · DEC 1983",
                        "THE STORE REMEMBERS · DEC 1983"
                      ] }
                  ] }
              ] },

            { "id": "feature", "widget": "panel", "layout": "overlay", "style": "panel.feature", "slot": { "height": 200 },
              "children": [
                { "id": "showroom-img", "widget": "image", "slot": { "align": "center", "valign": "center" },
                  "bind": { "size": "'280,180'" },
                  "idle": "Breathe", "idle_seconds": 6,
                  "pool": [ "mod:icons/ui/showroom-living-room", "mod:icons/ui/showroom-kitchen", "mod:icons/ui/showroom-bedroom",
                            "mod:icons/ui/showroom-dining-room", "mod:icons/ui/showroom-kids-room", "mod:icons/ui/showroom-hallway" ],
                  "captions": [ "Showroom A · Living Room", "Showroom B · Kitchen", "Showroom C · Bedroom",
                                "Showroom D · Dining Room", "Showroom E · Kids Room", "Showroom F · Hallway" ] },
                { "widget": "panel", "style": "chip.badge", "slot": { "align": "left", "valign": "top", "padding": 8 },
                  "children": [ { "id": "showroom-cap", "widget": "text", "style": "text.badge", "text": "Showroom · Featured", "bind": { "text": "#showroom-img.caption" } } ] }
              ] },

            { "id": "rows", "widget": "panel", "layout": "vertical", "focus": "group", "slot": { "padding": [6, 4, 10, 4] },
              "children": [
                { "id": "start-row", "widget": "panel", "layout": "overlay",
                  "children": [
                    { "id": "btn-start", "widget": "button", "style": "button.row", "label": "New Game", "dept": "Dept. 04", "page": "PG. 04", "first_in_group": true, "focus": "initial",
                      "slot": { "align": "fill" },
                      "bind": { "disabled": "UI.Boot.ShaderGate.bPrecompiling" },
                      "on": { "click": { "cmd": "UI.Cmd.Menu.Navigate", "args": { "Screen": "NewStore" } } } },
                    { "id": "shader-gate", "widget": "panel", "layout": "vertical", "gap": 3, "slot": { "align": "right", "valign": "center", "width": 130, "padding": [0, 14, 0, 0] },
                      "bind": { "visible": "UI.Boot.ShaderGate.bPrecompiling" },
                      "children": [
                        { "widget": "panel", "layout": "horizontal",
                          "children": [
                            { "widget": "text", "style": "menu.text.shadergate", "text": "Shaders", "slot": { "fill": true } },
                            { "id": "shader-gate-pct", "widget": "text", "style": "menu.text.shadergate", "slot": { "align": "right" }, "bind": { "text": "UI.Boot.ShaderGate.Caption" } }
                          ] },
                        { "id": "shader-gate-fill", "widget": "progressbar", "style": "menu.bar.shadergate", "progress": 0, "slot": { "align": "fill" },
                          "bind": { "progress": "UI.Boot.ShaderGate.Progress" } }
                      ] }
                  ] },
                { "id": "btn-load",      "widget": "button", "style": "button.row", "label": "Load Save",          "dept": "Dept. 12", "page": "PG. 12",
                  "on": { "click": { "cmd": "UI.Cmd.Menu.Navigate", "args": { "Screen": "LoadSave" } } } },
                { "id": "btn-friends",   "widget": "button", "style": "button.row", "label": "Join Friends",       "dept": "Dept. 07", "page": "PG. 07",
                  "on": { "click": { "cmd": "UI.Cmd.Menu.JoinFriends" } } },
                { "id": "btn-mods",      "widget": "button", "style": "button.row", "label": "Mods",               "dept": "Dept. 33", "page": "PG. 33",
                  "on": { "click": { "cmd": "UI.Cmd.Menu.Navigate", "args": { "Screen": "Mods" } } } },
                { "id": "btn-character", "widget": "button", "style": "button.row", "label": "Customise Character", "dept": "Dept. 02", "page": "PG. 02",
                  "on": { "click": { "cmd": "UI.Cmd.Menu.Navigate", "args": { "Screen": "Character" } } } },
                { "id": "btn-settings",  "widget": "button", "style": "button.row", "label": "Settings",           "dept": "Dept. 88", "page": "PG. 88",
                  "on": { "click": { "cmd": "UI.Cmd.Menu.Navigate", "args": { "Screen": "Settings" } } } },
                { "id": "btn-credits",   "widget": "button", "style": "button.row", "label": "Credits",            "dept": "Dept. 99", "page": "PG. 99",
                  "on": { "click": { "cmd": "UI.Cmd.Menu.Navigate", "args": { "Screen": "Credits" } } } },
                { "id": "btn-exit",      "widget": "button", "style": "button.row", "label": "Leave the Store",    "dept": "Fire Exit", "page": "END",
                  "on": { "click": { "cmd": "UI.Cmd.Menu.Exit" } } }
              ] }
          ] },

        { "id": "menu-vol", "widget": "panel", "layout": "horizontal", "style": "menu.live.chip.vol", "gap": 10, "slot": { "align": "right", "valign": "bottom", "padding": [0, 18, 14, 0] },
          "children": [
            { "widget": "text", "style": "text.badge", "text": "Menu Music", "slot": { "valign": "center" } },
            { "id": "menu-vol-mute", "widget": "button", "style": "menu.live.button.vol.round", "label": "Mute", "slot": { "valign": "center" },
              "bind": { "visible": "UI.Settings.Value[audio.menu_music].Value.Number > 0.001" },
              "on": { "click": { "cmd": "UI.Cmd.Settings.Set", "args": { "Key": "audio.menu_music", "Value": 0 } } } },
            { "id": "menu-vol-unmute", "widget": "button", "style": "menu.live.button.vol.round", "label": "Unmute", "slot": { "valign": "center" },
              "bind": { "visible": "!(UI.Settings.Value[audio.menu_music].Value.Number > 0.001)" },
              "on": { "click": { "cmd": "UI.Cmd.Settings.Unmute", "args": { "Key": "audio.menu_music" } } } },
            { "id": "menu-vol-slider", "widget": "slider", "min": 0, "max": 1, "step": 0.01, "show_value": false, "track_width": 110, "slot": { "valign": "center" },
              "bind": { "value": "UI.Settings.Value[audio.menu_music].Value.Number" },
              "on": { "commit": { "cmd": "UI.Cmd.Settings.Set", "args": { "Key": "audio.menu_music", "Value": "{self.value}" } } } }
          ] }
      ]
    }
  }
}
