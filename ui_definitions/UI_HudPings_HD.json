{
  "id": "UI_HudPings_HD",
  "class": "ScpUiScreenDefinition",
  "properties": {
    "layer": "hud",
    "order": 6,
    "uses": [
      "UI.Hud.Visibility",
      "UI.Ping.Set"
    ],
    "tree": {
      "id": "pings-root",
      "widget": "panel",
      "layout": "overlay",
      "style": "panel.flat",
      "bind": {
        "visible": "UI.Hud.Visibility[ping].bHidden ? false : !UI.Hud.Visibility[all].bHidden"
      },
      "children": [
        {
          "id": "ping-markers",
          "widget": "list",
          "style": "hud.overlay.rows",
          "selectable": false,
          "overlay_rows": true,
          "row_key": "PingId",
          "bind": {
            "items": "UI.Ping.Set.Pings"
          },
          "template": {
            "id": "ping-marker",
            "widget": "worldmarker",
            "clamp_to_screen": true,
            "hide_when_behind": false,
            "stack": true,
            "bind": {
              "world_location": "\"{item.Location.X},{item.Location.Y},{item.Location.Z}\"",
              "pivot": "'0.5,1'"
            },
            "children": [
              {
                "widget": "panel",
                "layout": "vertical",
                "style": "panel.flat",
                "gap": 2,
                "children": [
                  {
                    "id": "ping-chip",
                    "widget": "panel",
                    "layout": "horizontal",
                    "gap": 4,
                    "slot": {
                      "align": "center"
                    },
                    "bind": {
                      "style": "item.PingType == 'Enemy' ? 'hud.ping.chip.enemy' : (item.PingType == 'Entity' ? 'hud.ping.chip.loot' : (item.PingType == 'Danger' ? 'hud.ping.chip.danger' : (item.PingType == 'Player' ? 'hud.ping.chip.player' : (item.PingType == 'Map' ? 'hud.ping.chip.waypoint' : 'hud.ping.chip.move'))))"
                    },
                    "children": [
                      {
                        "widget": "image",
                        "slot": {
                          "valign": "center"
                        },
                        "bind": {
                          "source": "item.PingType == 'Enemy' ? 'mod:icons/ui/ping-enemy' : (item.PingType == 'Entity' ? 'mod:icons/ui/ping-loot' : (item.PingType == 'Danger' ? 'mod:icons/ui/ping-danger' : 'mod:icons/ui/ping-move'))",
                          "size": "'12,12'",
                          "style": "item.PingType == 'Enemy' ? 'hud.ping.icon.enemy' : (item.PingType == 'Entity' ? 'hud.ping.icon.loot' : (item.PingType == 'Danger' ? 'hud.ping.icon.danger' : (item.PingType == 'Player' ? 'hud.ping.icon.player' : (item.PingType == 'Map' ? 'hud.ping.icon.waypoint' : 'hud.ping.icon.move'))))"
                        }
                      },
                      {
                        "id": "ping-label",
                        "widget": "text",
                        "slot": {
                          "valign": "center"
                        },
                        "bind": {
                          "text": "item.Label",
                          "style": "item.PingType == 'Enemy' ? 'hud.ping.text.enemy' : (item.PingType == 'Entity' ? 'hud.ping.text.loot' : (item.PingType == 'Danger' ? 'hud.ping.text.danger' : (item.PingType == 'Player' ? 'hud.ping.text.player' : (item.PingType == 'Map' ? 'hud.ping.text.waypoint' : 'hud.ping.text.move'))))"
                        }
                      }
                    ]
                  },
                  {
                    "id": "ping-distance",
                    "widget": "text",
                    "style": "hud.ping.distance",
                    "justify": "Center",
                    "slot": {
                      "align": "center"
                    },
                    "bind": {
                      "text": "item.OwnerName != '' ? \"{item.Distance}  {item.OwnerName}\" : item.Distance",
                      "visible": "item.Distance != ''"
                    }
                  }
                ]
              }
            ]
          }
        }
      ]
    }
  }
}
