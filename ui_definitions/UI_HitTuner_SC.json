                        {
                          "widget": "slider",
                          "id": "ht-PhysicsKick",
                          "min": 0,
                          "max": 4,
                          "step": 0.05,
                          "track_width": 180,
                          "show_value": true,
                          "value_format": "{0}",
                          "style": "dev.slider.orange",
                          "slot": {
                            "fill": true,
                            "valign": "center"
                          },
                          "bind": {
                            "value": "UI.HitTuner.State.Tuning.PhysicsKick"
                          },
                          "on": {
                            "commit": {
                              "cmd": "UI.Cmd.HitTuner.SetValue",
                              "args": {
                                "Field": "PhysicsKick",
                                "Value": "{self.value}"
                              }
                            }
                          }
                        }
                      ]
                    },
                    {
                      "widget": "panel",
                      "layout": "horizontal",
                      "gap": 6,
                      "children": [
                        {
                          "widget": "text",
                          "text": "Physics decay (s)",
                          "style": "dev.label",
                          "slot": {
                            "width": 118,
                            "valign": "center"
                          }
                        },
                        {
                          "widget": "slider",
                          "id": "ht-PhysicsSeconds",
                          "min": 0.05,
                          "max": 3,
                          "step": 0.05,
                          "track_width": 180,
                          "show_value": true,
                          "value_format": "{0}",
                          "style": "dev.slider.orange",
                          "slot": {
                            "fill": true,
                            "valign": "center"
                          },
                          "bind": {
                            "value": "UI.HitTuner.State.Tuning.PhysicsSeconds"
                          },
                          "on": {
                            "commit": {
                              "cmd": "UI.Cmd.HitTuner.SetValue",
                              "args": {
                                "Field": "PhysicsSeconds",
                                "Value": "{self.value}"
                              }
                            }
                          }
                        }
                      ]
                    }
                  ]
                },
                {
                  "widget": "panel",
                  "layout": "horizontal",
                  "id": "ht-buttons",
                  "focus": "group",
                  "gap": 6,
                  "children": [
                    {
                      "widget": "button",
                      "label": "Reset to tier default",
                      "style": "dev.button",
                      "on": {
                        "click": {
                          "cmd": "UI.Cmd.HitTuner.Reset"
                        }
                      }
                    },
                    {
                      "widget": "button",
                      "label": "Apply to whole tier",
                      "style": "dev.button",
                      "on": {
                        "click": {
                          "cmd": "UI.Cmd.HitTuner.ApplyToTier"
                        }
                      }
                    },
                    {
                      "widget": "button",
                      "label": "Close",
                      "style": "dev.button",
                      "on": {
                        "click": {
                          "cmd": "UI.Cmd.HitTuner.Toggle"
                        }
                      }
                    }
                  ]
                },
                {
                  "widget": "text",
                  "style": "dev.text.json",
                  "wrap": true,
                  "bind": {
                    "text": "UI.HitTuner.State.JsonPath != '' ? \"Saved live to {UI.HitTuner.State.JsonPath}\" : ''"
                  }
                }
              ]
            }
          ]
        }
      ]
    }
  }
}
