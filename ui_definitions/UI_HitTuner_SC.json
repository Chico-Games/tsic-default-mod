{
  "id": "UI_HitTuner_SC",
  "class": "ScpUiScreenDefinition",
  "properties": {
    "screen": "HitTuner",
    "layer": "menu",
    "input_mode": "InputMode.Menu.Generic",
    "cancel": "UI.Cmd.HitTuner.Toggle",
    "actions": [
      {
        "action": "accept",
        "label": "Select"
      },
      {
        "action": "back",
        "label": "Close"
      }
    ],
    "uses": [
      "UI.HitTuner.State"
    ],
    "tree": {
      "widget": "panel",
      "layout": "overlay",
      "id": "ht-root",
      "style": "screen.clear",
      "on": {
        "show": {
          "cmd": "UI.Cmd.HitTuner.RequestState"
        }
      },
      "children": [
        {
          "widget": "panel",
          "layout": "scroll",
          "id": "ht-panel",
          "style": "dev.panel.dock",
          "slot": {
            "align": "right",
            "valign": "fill",
            "width": 420
          },
          "children": [
            {
              "widget": "panel",
              "layout": "vertical",
              "gap": 8,
              "slot": {
                "padding": [
                  14,
                  12,
                  14,
                  16
                ]
              },
              "children": [
                {
                  "widget": "text",
                  "text": "Hit reaction tuner",
                  "style": "dev.title.tuner.arena"
                },
                {
                  "widget": "text",
                  "bind": {
                    "text": "!has:UI.HitTuner.State ? '' : UI.HitTuner.State.Message != '' ? UI.HitTuner.State.Message : UI.HitTuner.State.bHasOverride ? 'Clip has its own values.' : 'Clip is on its tier default.'",
                    "style": "has:UI.HitTuner.State ? (!UI.HitTuner.State.bHasTuner ? 'dev.status.bad' : 'dev.status') : 'dev.status'"
                  }
                },
                {
                  "widget": "panel",
                  "layout": "horizontal",
                  "gap": 8,
                  "children": [
                    {
                      "widget": "button",
                      "label": "<",
                      "style": "dev.button",
                      "id": "ht-prev",
                      "focus": "initial",
                      "slot": {
                        "valign": "center"
                      },
                      "on": {
                        "click": {
                          "cmd": "UI.Cmd.HitTuner.Nav",
                          "args": {
                            "Delta": -1
                          }
                        }
                      }
                    },
                    {
                      "widget": "panel",
                      "layout": "vertical",
                      "slot": {
                        "fill": true,
                        "valign": "center"
                      },
                      "children": [
                        {
                          "widget": "text",
                          "style": "dev.label.strong",
                          "justify": "Center",
                          "bind": {
                            "text": "UI.HitTuner.State.Count > 0 ? \"{UI.HitTuner.State.Index + 1} / {UI.HitTuner.State.Count}  -  {UI.HitTuner.State.Label}\" : '-'"
                          }
                        },
                        {
                          "widget": "text",
                          "style": "dev.meta",
                          "justify": "Center",
                          "wrap": true,
                          "bind": {
                            "text": "UI.HitTuner.State.MontageName != '' ? \"{UI.HitTuner.State.MontageName}  ({UI.HitTuner.State.ClipSeconds}s clip)\" : ''"
                          }
                        }
                      ]
                    },
                    {
                      "widget": "button",
                      "label": ">",
                      "style": "dev.button",
                      "id": "ht-next",
                      "slot": {
                        "valign": "center"
                      },
                      "on": {
                        "click": {
                          "cmd": "UI.Cmd.HitTuner.Nav",
                          "args": {
                            "Delta": 1
                          }
                        }
                      }
                    }
                  ]
                },
                {
                  "widget": "panel",
                  "layout": "vertical",
                  "id": "ht-dummy",
                  "style": "dev.section",
                  "gap": 5,
                  "focus": "group",
                  "children": [
                    {
                      "widget": "text",
                      "text": "Dummy",
                      "style": "dev.section.head"
                    },
                    {
                      "widget": "panel",
                      "layout": "horizontal",
                      "gap": 6,
                      "children": [
                        {
                          "widget": "button",
                          "label": "Idle",
                          "style": "dev.button",
                          "bind": {
                            "style": "UI.HitTuner.State.Locomotion == 'Idle' ? 'dev.button.on' : 'dev.button'"
                          },
                          "on": {
                            "click": {
                              "cmd": "UI.Cmd.HitTuner.SetLocomotion",
                              "args": {
                                "Mode": "Idle"
                              }
                            }
                          }
                        },
                        {
                          "widget": "button",
                          "label": "Walk",
                          "style": "dev.button",
                          "bind": {
                            "style": "UI.HitTuner.State.Locomotion == 'Walk' ? 'dev.button.on' : 'dev.button'"
                          },
                          "on": {
                            "click": {
                              "cmd": "UI.Cmd.HitTuner.SetLocomotion",
                              "args": {
                                "Mode": "Walk"
                              }
                            }
                          }
                        },
                        {
                          "widget": "button",
                          "label": "Run",
                          "style": "dev.button",
                          "bind": {
                            "style": "UI.HitTuner.State.Locomotion == 'Run' ? 'dev.button.on' : 'dev.button'"
                          },
                          "on": {
                            "click": {
                              "cmd": "UI.Cmd.HitTuner.SetLocomotion",
                              "args": {
                                "Mode": "Run"
                              }
                            }
                          }
                        },
                        {
                          "widget": "button",
                          "label": "Replay now",
                          "style": "dev.button",
                          "on": {
                            "click": {
                              "cmd": "UI.Cmd.HitTuner.Replay"
                            }
                          }
                        }
