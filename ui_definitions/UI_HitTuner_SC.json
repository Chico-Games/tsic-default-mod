                          "widget": "slider",
                          "id": "ht-interval",
                          "min": 0,
                          "max": 10,
                          "step": 0.5,
                          "track_width": 180,
                          "show_value": true,
                          "value_format": "{0}",
                          "style": "dev.slider.orange",
                          "slot": {
                            "fill": true,
                            "valign": "center"
